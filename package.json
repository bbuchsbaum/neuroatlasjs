{
  "name": "neuroatlasjs",
  "version": "0.1.0",
  "description": "A small, typed atlas core for neuroimaging volumes and surfaces",
  "license": "MIT",
  "author": "Bradley Buchsbaum",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:package": "node scripts/verify-package.mjs",
    "check": "npm run typecheck && npm test && npm run test:package && npm run docs:check",
    "prepare": "npm run build",
    "prepublishOnly": "npm run check",
    "docs:check": "tsc -p tsconfig.docs.json && node scripts/check-docs.mjs",
    "docs:api": "typedoc",
    "docs:dev": "npm run build && npm run docs:api && vitepress dev docs",
    "docs:build": "npm run build && npm run docs:check && npm run docs:api && vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "neuroimjs": "0.5.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typedoc-vitepress-theme": "^1.1.4",
    "typescript": "5.9.3",
    "vitepress": "^1.6.4",
    "vue": "^3.5.43"
  }
}
